{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Milestone 1 intervention",
  "description": "Declarative guidance only. This schema does not define runtime behavior.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "primitive", "implementation", "triggers", "preconditions", "intervention", "validation", "metadata"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "The supported declarative format version. No automatic migration."
    },
    "primitive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contract_version", "domain", "category"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 240,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)+(?![\\s\\S])",
          "description": "Dot-separated conceptual problem ID, independent of implementation language and provider."
        },
        "contract_version": {"$ref": "#/$defs/version"},
        "domain": {"$ref": "#/$defs/slug"},
        "category": {"$ref": "#/$defs/slug"}
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "version", "provider"],
      "properties": {
        "language": {
          "$ref": "#/$defs/slug",
          "description": "Implementation language, or agnostic for guidance independent of a programming language."
        },
        "version": {"$ref": "#/$defs/version"},
        "provider": {
          "type": "string",
          "maxLength": 240,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+(?![\\s\\S])",
          "description": "Publisher's reverse-DNS identifier. Ownership is not verified by the schema."
        }
      }
    },
    "triggers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "value"],
        "properties": {
          "kind": {"enum": ["exception", "message"]},
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S",
            "description": "An exception name or literal message fragment, never an expression or regex."
          }
        }
      }
    },
    "preconditions": {
      "$ref": "#/$defs/checklist",
      "description": "Human-readable applicability conditions. Empty means no additional conditions."
    },
    "intervention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "token_budget", "payload"],
      "properties": {
        "type": {"const": "guidance"},
        "token_budget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096,
          "description": "Declared target ceiling for payload tokens. No tokenizer is selected in Milestone 1."
        },
        "payload": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000,
          "pattern": "\\S",
          "description": "Plain text or Markdown guidance. Always inert data, with no template evaluation."
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success_criteria"],
      "properties": {
        "success_criteria": {
          "$ref": "#/$defs/checklist",
          "minItems": 1,
          "description": "Observable outcomes for human review, not executable assertions."
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary", "authors"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S"},
        "summary": {"$ref": "#/$defs/text"},
        "authors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S"}
        },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/slug"}
        }
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])",
      "description": "MAJOR.MINOR.PATCH, without prerelease or build suffix."
    },
    "slug": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
    },
    "text": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S"},
    "checklist": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/text"}
    }
  }
}
